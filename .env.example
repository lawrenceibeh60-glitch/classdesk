# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Exactly two private ClassDesk accounts. Generate each hash with:
# node scripts/hash-password.mjs 'a-long-unique-password'
CLASS_REP_USERNAME="classrep"
CLASS_REP_PASSWORD_HASH=""
ASSISTANT_REP_USERNAME="assistantrep"
ASSISTANT_REP_PASSWORD_HASH=""

# Legacy primary-account hash fallback during migration only.
# Remove after CLASS_REP_PASSWORD_HASH is configured.
ADMIN_PASSWORD_HASH=""

# Optional development-only legacy fallback is intentionally unsupported for login.
# Never store plaintext account passwords in source control or client-side variables.

# Shared S3-compatible object storage. REQUIRED in production for original document files
# and backup-restored originals. PostgreSQL stores searchable extracted text and metadata.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="afit-classdesk"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional OpenAI-compatible Chat Completions endpoint.
# Keep the API key server-side; never use NEXT_PUBLIC_ for this value.
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL=""
AI_REQUEST_TIMEOUT_MS="60000"
MISTRAL_API_KEY=""
ELEVENLABS_API_KEY=""

# Optional; clamped to 1–50 MB (default 20 MB).
MAX_UPLOAD_MB="20"

# Optional ClamAV daemon. If configured, every uploaded file is scanned before indexing.
# Set REQUIRE_MALWARE_SCAN=true to reject uploads unless a scanner is configured.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
REQUIRE_MALWARE_SCAN="false"

# OCR page limit for scanned PDFs (1–20, default 8).
OCR_MAX_PAGES="8"
