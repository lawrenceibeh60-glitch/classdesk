# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Preferred administrator credential: generate with node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=""
# Development-only fallback. Do not use this plain password variable in production.
ADMIN_PASSWORD=""

# Optional private S3-compatible object storage. Without it, extracted text is kept
# in PostgreSQL but original document bytes cannot be downloaded later.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="afit-classdesk"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional OpenAI-compatible Chat Completions endpoint.
# Keep the API key server-side; never use NEXT_PUBLIC_ for this value.
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL=""
AI_REQUEST_TIMEOUT_MS="60000"

# Optional; clamped to 1–50 MB (default 20 MB).
MAX_UPLOAD_MB="20"

# Optional ClamAV daemon. If configured, every uploaded file is scanned before indexing.
# Set REQUIRE_MALWARE_SCAN=true to reject uploads unless a scanner is configured.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
REQUIRE_MALWARE_SCAN="false"

# OCR page limit for scanned PDFs (1–20, default 8).
OCR_MAX_PAGES="8"
