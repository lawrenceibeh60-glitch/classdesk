generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum RecordType {
  COURSE
  LECTURE
  ANNOUNCEMENT
  TASK
  STUDENT
  CONCERN
  CALENDAR
  TIMETABLE
}
enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}
enum AnnouncementStatus {
  DRAFT
  APPROVED
  PUBLISHED
  ARCHIVED
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model AcademicRecord {
  id String @id @default(cuid())
  type RecordType
  title String
  content String @default("") @db.Text
  metadata Json @default("{}")
  eventDate DateTime?
  status String @default("ACTIVE")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([type, updatedAt])
  @@index([eventDate])
}

model Document {
  id String @id @default(cuid())
  title String
  filename String
  mimeType String
  sizeBytes Int
  storageKey String?
  extractedText String @default("") @db.Text
  courseCode String?
  courseName String?
  lectureDate DateTime?
  topic String?
  status DocumentStatus @default(PROCESSING)
  securityScanStatus String @default("UNSCANNED")
  errorMessage String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks DocumentChunk[]
  @@index([courseCode, lectureDate])
  @@index([status, createdAt])
}

model DocumentChunk {
  id String @id @default(cuid())
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content String @db.Text
  createdAt DateTime @default(now())
  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model Announcement {
  id String @id @default(cuid())
  title String
  body String @db.Text
  category String @default("GENERAL")
  source String?
  status AnnouncementStatus @default(DRAFT)
  scheduledFor DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
  versions AnnouncementVersion[]
  events AnnouncementEvent[]
}

model SyncMutation {
  id String @id
  entityType String
  entityId String
  operation String
  payload Json
  createdAt DateTime @default(now())
  appliedAt DateTime?
  @@index([appliedAt, createdAt])
}

model Course {
  id String @id @default(cuid())
  code String @unique
  name String
  lecturer String?
  semester String?
  description String? @db.Text
  active Boolean @default(true)
  lectures LectureSession[]
  assignments Assignment[]
  attendance AttendanceSummary[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, code])
}

model LectureSession {
  id String @id @default(cuid())
  courseId String?
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  topic String
  summary String @default("") @db.Text
  scheduledAt DateTime?
  heldAt DateTime?
  venue String?
  lecturer String?
  sourceDocumentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([courseId, heldAt])
  @@index([scheduledAt])
}

model Assignment {
  id String @id @default(cuid())
  courseId String?
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title String
  details String @default("") @db.Text
  dueAt DateTime?
  status TaskStatus @default(TODO)
  submissionInstructions String? @db.Text
  source String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, dueAt])
  @@index([courseId, dueAt])
}

model AttendanceSummary {
  id String @id @default(cuid())
  courseId String?
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sessionDate DateTime
  presentCount Int @default(0)
  absentCount Int @default(0)
  note String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([courseId, sessionDate])
}

model ClassConcern {
  id String @id @default(cuid())
  category String @default("GENERAL")
  title String
  details String @db.Text
  status String @default("OPEN")
  resolution String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
}

model AnnouncementVersion {
  id String @id @default(cuid())
  announcementId String
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  version Int
  title String
  body String @db.Text
  status AnnouncementStatus
  createdAt DateTime @default(now())
  @@unique([announcementId, version])
  @@index([announcementId, createdAt])
}

model RateLimitBucket {
  key String @id
  count Int @default(0)
  resetAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([resetAt])
}

model AnnouncementEvent {
  id String @id @default(cuid())
  announcementId String
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  action String
  details String? @db.Text
  createdAt DateTime @default(now())
  @@index([announcementId, createdAt])
}

model AiRequestReceipt {
  id String @id
  kind String
  response Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model AiTask {
  id String @id @default(cuid())
  ownerId String
  ownerUsername String
  kind String
  status String @default("QUEUED")
  input Json
  output Json?
  progress Int @default(0)
  currentStep String @default("Queued")
  errorMessage String? @db.Text
  resultDocumentId String?
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lockedAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, createdAt])
  @@index([status, availableAt, createdAt])
  @@index([resultDocumentId])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String
  actorUsername String
  actorRole String
  action String
  targetType String
  targetId String?
  details Json?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model AiWorkerState {
  id String @id
  startedAt DateTime @default(now())
  lastSeenAt DateTime @updatedAt
  @@index([lastSeenAt])
}
